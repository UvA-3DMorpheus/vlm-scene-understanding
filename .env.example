# Copy to .env (gitignored) and fill in values. Never commit values.
# On Snellius put the key lines in ~/.config/vsu/secrets.env (chmod 600);
# scripts/snellius/env.sh sources that file.

# --- API keys for closed models (read by the OpenAI and Gemini backends) ---
OPENAI_API_KEY=
# Optional: point the OpenAI compatible backend at another server (vLLM, Azure, OpenRouter).
# OPENAI_BASE_URL=
GEMINI_API_KEY=
# Optional: needed only for gated Hugging Face repositories.
# HF_TOKEN=

# --- Paths (defaults shown; relative paths resolve against the working directory) ---
# On Snellius these are exported by scripts/snellius/env.sh, do not set them in .env there.
VSU_DATA_ROOT=./data
VSU_RESULTS_ROOT=./results/runs
VSU_CACHE_ROOT=./.cache
# Hugging Face cache for model weights. Leave unset to use the Hugging Face default.
# HF_HOME=
